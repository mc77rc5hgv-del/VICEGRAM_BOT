# Telegram bot token from @BotFather
BOT_TOKEN=123456:AAAA-your-bot-token
# Space or comma separated Telegram user IDs allowed to use /admin_* commands
ADMIN_IDS=111111111,222222222

# Where the SQLite database is stored
DB_PATH=/etc/med-vpn/med-vpn.db

# Filled in from the output of server/install.sh
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_PUBLIC_KEY=REPLACE_ME
XRAY_SHORT_ID=REPLACE_ME
XRAY_SERVER_NAME=www.microsoft.com
XRAY_SERVER_ENDPOINT=REPLACE_ME:443

SERVICE_NAME=MED VPN
