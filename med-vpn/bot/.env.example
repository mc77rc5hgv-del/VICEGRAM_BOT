# Telegram bot token from @BotFather
BOT_TOKEN=123456:AAAA-your-bot-token
# Space or comma separated Telegram user IDs allowed to use /admin_* commands
ADMIN_IDS=111111111,222222222

# Where the SQLite database is stored
DB_PATH=/etc/med-vpn/med-vpn.db

# Filled in from the output of server/install.sh
WG_INTERFACE=wg0
WG_CONF_PATH=/etc/wireguard/wg0.conf
WG_SUBNET=10.66.0.0/22
WG_SERVER_PUBLIC_KEY=REPLACE_ME
WG_SERVER_ENDPOINT=REPLACE_ME:51820

# Optional
WG_CLIENT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
SERVICE_NAME=MED VPN
