# Telegram bot token from @BotFather
BOT_TOKEN=123456:AAAA-your-bot-token
# Space or comma separated Telegram user IDs allowed to use /admin_* commands
ADMIN_IDS=111111111,222222222

# Where the SQLite database is stored
DB_PATH=/etc/med-vpn/med-vpn.db

# Filled in from the output of server/install.sh
HYSTERIA_CONFIG_PATH=/etc/hysteria/config.yaml
HYSTERIA_CERT_PATH=/etc/hysteria/cert.pem
HYSTERIA_SERVER_ENDPOINT=REPLACE_ME:443
HYSTERIA_SNI=med-vpn.internal

SERVICE_NAME=MED VPN

# Referral program
REFERRAL_COMMISSION_RATE=0.10
DEFAULT_CURRENCY=RUB
# Invite this many people and get free unlimited access automatically
REFERRAL_FREE_THRESHOLD=3

# Telegram username (no @) support redirects to for manual rouble payments
SUPPORT_USERNAME=vmeda_helper
